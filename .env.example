# Copy to .env and fill in. .env is gitignored, never uploaded to a sandbox, and never logged.

# Claude through Amazon Bedrock: the AWS lab account's "Get AWS CLI credentials" values
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# optional: a Bedrock model or inference profile id; empty = the newest Claude the account can call
HONEST_ALPHA_MODEL=

# or Claude directly (used instead of Bedrock when set)
ANTHROPIC_API_KEY=

# Daytona: the search sandboxes
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Arize AX: traces of every agent step
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=honest-alpha

# SurrealDB Agent Memory: the context host, its id and an sp-... key from SurrealDB Studio
SPECTRON_URL=
SPECTRON_CONTEXT_ID=
SPECTRON_API_KEY=
